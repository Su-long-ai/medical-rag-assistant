# Chat model: deepseek | openai_compatible
LLM_PROVIDER=deepseek
LLM_MODEL=deepseek-chat
DEEPSEEK_API_KEY=

# For an OpenAI-compatible endpoint instead of DeepSeek:
# LLM_PROVIDER=openai_compatible
# LLM_API_KEY=
# LLM_BASE_URL=https://example.com/v1

# Embeddings / RAG
ZHIPU_API_KEY=
EMBEDDING_MODEL=embedding-3

# Optional current-information search (disabled by default)
ENABLE_WEB_SEARCH=false
TAVILY_API_KEY=

# Optional read-only graph lookup (disabled by default)
ENABLE_GRAPH_TOOL=false
NEO4J_URI=neo4j://localhost:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=

# Destructive/debug endpoints are disabled by default
ENABLE_ADMIN_ENDPOINTS=false

# Local development policy
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
MAX_FILE_SIZE_BYTES=10485760
MAX_PDF_PAGES=50
CHUNK_SIZE=1000
CHUNK_OVERLAP=150
MAX_RETRIEVED_DOCS=5
OCR_LANGUAGES=chi_sim+eng
